NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (server-only — never use NEXT_PUBLIC_ prefix)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=notifications@your-verified-domain.com

# Kingston Jiu Jitsu — Google Ads trial enquiry conversion label (from Google Ads conversion action)
# Combined at runtime with the AW- tag ID stored in Pixel Settings, e.g. AW-846017609/your_label_here
NEXT_PUBLIC_GOOGLE_ADS_TRIAL_ENQUIRY_CONVERSION_LABEL=
