{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "verify:instructor-portal-sync": "node scripts/verify-instructor-portal-membership-sync.mjs",
    "test:waitlist": "npx --yes tsx --test src/lib/session-waitlist.shared.test.ts",
    "test:portal-auth-errors": "npx --yes tsx --test src/lib/portal-auth-errors.shared.test.ts",
    "test:junior-belt-rankings": "npx --yes tsx --test src/lib/junior-belt-rankings.shared.test.ts",
    "test:grade-awards": "npx --yes tsx --test src/lib/admin-belt-promotion.shared.test.ts",
    "test:grade-award-delete": "npx --yes tsx --test src/lib/admin-grade-award.shared.test.ts",
    "test:class-session-schedule": "npx --yes tsx --test src/lib/class-session-schedule.test.ts",
    "test:class-metrics": "npx --yes tsx --test src/lib/admin-class-metrics.shared.test.ts",
    "test:london-datetime": "npx --yes tsx --test src/lib/london-datetime.test.ts",
    "test:lead-attribution": "node --experimental-strip-types --test src/lib/lead-attribution.shared.test.ts",
    "test:leads-shared": "node --experimental-strip-types --import ./scripts/register-tsconfig-paths.mjs --test src/lib/leads.shared.test.ts",
    "test:lead-status-tracking": "node --experimental-strip-types --import ./scripts/register-tsconfig-paths.mjs --test src/lib/lead-status-tracking.shared.test.ts",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "audit:pwa": "npm run build && npx --yes lighthouse http://localhost:3000/app --only-categories=pwa --chrome-flags='--headless --no-sandbox' --output=json --output-path=./lighthouse-pwa-report.json",
    "verify:london-migrations": "node scripts/verify-london-recurring-migrations.mjs",
    "repair:london-sessions": "node scripts/repair-london-timetable-sessions.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.106.2",
    "next": "^14.2.33",
    "pdf-lib": "^1.17.1",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "png-to-ico": "^3.0.1",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
